# Cibo backend dev environment
# ----------------------------------------------------------------------------
# Copy this file to `apps/backend/.env` (gitignored) and fill in the real
# values. The backend auto-loads .env on startup, so you can run:
#
#     cd apps/backend
#     .venv/bin/python -m uvicorn foodlens_backend.main:app --host 127.0.0.1 --port 8000 --app-dir src
#
# without exporting anything in the shell.

# Required: Gemini API key. Get one (free tier) at:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required: HMAC secret used to sign auth JWTs. For dev, anything random
# works. For prod: `openssl rand -base64 48` and never commit it.
JWT_SECRET=

# Required: Postgres connection string. SQLAlchemy + psycopg 3.
#
#   LOCAL DEV (Homebrew Postgres on macOS, no password by default):
#     DATABASE_URL=postgresql+psycopg://<your-os-user>@localhost:5432/cibo
#   First-time DB creation: `createdb cibo`
#
#   PRODUCTION (Render / Fly / Neon / Supabase):
#     DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
#   Most providers give you the URL pre-formed; just paste it here.
#   Note: if the provider hands you a `postgres://...` URL, change the
#   scheme to `postgresql+psycopg://...` so SQLAlchemy uses psycopg 3.
DATABASE_URL=
